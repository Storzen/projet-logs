# Copier vers .env puis renseigner les valeurs (ou utiliser Doppler, voir README).

POSTGRES_DB=todos
POSTGRES_USER=todouser
POSTGRES_PASSWORD=changeme_mot_de_passe_fort

GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme_mot_de_passe_fort

# AWS : authentification ECR (CI) et backup S3 des données Loki
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ACCOUNT_ID=
AWS_DEFAULT_REGION=eu-west-3
S3_BUCKET_NAME=votre-bucket-logs-backup

# Requis par Traefik pour obtenir les certificats Let's Encrypt
ACME_EMAIL=vous@example.com
